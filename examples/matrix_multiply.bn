module matrix_multiply
extern fn print_i64(v: i64)
// 2x2 matrices stored as 4 i32 row-major

fn mat_mul(a: ptr, b: ptr, out: ptr) -> unit {
  var i: i64 = 0
  loop {
    if i.ge.s(2) { break }
    var j: i64 = 0
    loop {
      if j.ge.s(2) { break }
      var acc: i32 = 0
      var k: i64 = 0
      loop {
        if k.ge.s(2) { break }
        let ai: ptr = int2ptr(ptr2int(a).add.wrap(i.mul.wrap(2).add.wrap(k).mul.wrap(4)))
        let bk: ptr = int2ptr(ptr2int(b).add.wrap(k.mul.wrap(2).add.wrap(j).mul.wrap(4)))
        let av: i32 = load.unaligned<i32>(ai)
        let bv: i32 = load.unaligned<i32>(bk)
        acc = acc.add.wrap(av.mul.wrap(bv))
        k = k.add.wrap(1)
      }
      let o: ptr = int2ptr(ptr2int(out).add.wrap(i.mul.wrap(2).add.wrap(j).mul.wrap(4)))
      store.unaligned<i32>(o, acc)
      j = j.add.wrap(1)
    }
    i = i.add.wrap(1)
  }
  return
}

fn main() -> i64 {
  return 0
}
